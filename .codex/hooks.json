{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/guard-rules.mjs\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/lint-check.mjs\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/skill-suggest.mjs\"" }
        ]
      }
    ]
  }
}
