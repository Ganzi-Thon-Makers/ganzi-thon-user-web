{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "nextjs", "import", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": [".next/**", "next-env.d.ts"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "error",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "@testing-library/jest-dom/vitest"]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "ky",
            "message": "HTTP 요청은 @/shared/api/client의 api 인스턴스를 사용하세요."
          },
          {
            "name": "next/router",
            "message": "App Router에서는 next/navigation을 사용하세요."
          },
          {
            "name": "next/document",
            "message": "App Router에서는 layout.tsx와 metadata API를 사용하세요."
          }
        ],
        "patterns": [
          {
            "group": ["@base-ui/react", "@base-ui/react/*"],
            "message": "Base UI는 @/shared/ui에서 래핑한 컴포넌트를 사용하세요."
          }
        ]
      }
    ],
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-alert": "error",
    "prefer-const": "error",
    "no-var": "error",
    "no-implicit-coercion": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "import/no-duplicates": "error",
    "react/no-array-index-key": "error",
    "no-nested-ternary": "error",
    "react/button-has-type": "error",
    "react/jsx-no-target-blank": "error"
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "@/app/**"],
                "message": "shared는 도메인을 몰라야 합니다. (의존 방향: app → features → shared)"
              }
            ],
            "paths": [
              {
                "name": "next/router",
                "message": "App Router에서는 next/navigation을 사용하세요."
              },
              {
                "name": "next/document",
                "message": "App Router에서는 layout.tsx와 metadata API를 사용하세요."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "ky",
                "message": "HTTP 요청은 @/shared/api/client의 api 인스턴스를 사용하세요."
              },
              {
                "name": "next/router",
                "message": "App Router에서는 next/navigation을 사용하세요."
              },
              {
                "name": "next/document",
                "message": "App Router에서는 layout.tsx와 metadata API를 사용하세요."
              }
            ],
            "patterns": [
              {
                "group": ["@base-ui/react", "@base-ui/react/*"],
                "message": "Base UI는 @/shared/ui에서 래핑한 컴포넌트를 사용하세요."
              },
              {
                "group": ["@/features/**", "@/app/**"],
                "message": "feature 내부는 상대 경로로 import하고, 다른 feature는 import하지 마세요. 공유가 필요하면 shared로 올리세요."
              }
            ]
          }
        ]
      }
    }
  ]
}
